#!/usr/bin/env bash
# A fake wrangler for the deploy tests. It never reaches Cloudflare. Each call appends its arguments (one line) to $WR_LOG.
# $WR_STATE/live is "old" or "new": the version that the fake server (server.mjs) serves. `versions deploy` sets "new",
# `rollback` sets "old". $WR_STATE/pending holds the pending D1 migrations, one name on each line.
#   WR_LIVE           the version id of `deployments status --json` (empty: "no deployments", exit 1)
#   WR_SPLIT          not empty: the live deployment has two versions (a gradual deploy in progress)
#   WR_NEW            the id in the output of `versions upload` (default v-new; "none": no id line)
#   WR_UPLOAD_CODE    the exit code of `versions upload` (default 0)
#   WR_ROLLBACK_CODE  the exit code of `rollback` (default 0)
#   WR_APPLY          `d1 migrations apply`: "no" = the person answered no (nothing applied, exit 0, as wrangler 4);
#                     "fail" = the first migration applies, the second fails (exit 1)
# `d1 migrations apply` acts as wrangler 4: when it can read an answer on stdin (a terminal), "y" applies and another
# answer applies nothing (exit 0). With no stdin (non-interactive), it applies (the fallback value yes).
echo "$*" >> "${WR_LOG:?}"
table() { # the pending migrations as a cli-table3 table
  echo "┌────────────────────┐"; echo "│ Name               │"; echo "├────────────────────┤"
  while IFS= read -r m; do [ -n "$m" ] && printf '│ %-18s │\n' "$m"; done < "$WR_STATE/pending"
  echo "└────────────────────┘"
}
case "$1 $2" in
  "deployments status")
    if [ -z "${WR_LIVE-v-old}" ]; then echo "X [ERROR] The Worker app has no deployments." >&2; exit 1; fi
    if [ -n "${WR_SPLIT:-}" ]; then
      printf '{\n  "id": "dep-2",\n  "versions": [\n    { "version_id": "v-a", "percentage": 10 },\n    { "version_id": "%s", "percentage": 90 }\n  ]\n}\n' "${WR_LIVE-v-old}"
    else
      printf '{\n  "id": "dep-1",\n  "source": "wrangler",\n  "strategy": "percentage",\n  "author_email": "a@example.com",\n  "annotations": { "workers/message": "m", "workers/triggered_by": "deployment" },\n  "versions": [\n    { "version_id": "%s", "percentage": 100 }\n  ]\n}\n' "${WR_LIVE-v-old}"
    fi
    ;;
  "versions upload")
    echo "Total Upload: 120.00 KiB / gzip: 40.00 KiB"
    echo "Uploaded app (1.00 sec)"
    [ "${WR_NEW:-v-new}" = none ] || echo "Worker Version ID: ${WR_NEW:-v-new}"
    echo "Version Preview URL: https://v-new-app.example.workers.dev"
    exit "${WR_UPLOAD_CODE:-0}"
    ;;
  "versions deploy")
    echo new > "$WR_STATE/live"; echo "Deployed app version $3"
    ;;
  "rollback "*)
    [ "${WR_ROLLBACK_CODE:-0}" = 0 ] && echo old > "$WR_STATE/live"
    echo "Rolled back to $2"; exit "${WR_ROLLBACK_CODE:-0}"
    ;;
  "d1 migrations")
    touch "$WR_STATE/pending"
    if [ ! -s "$WR_STATE/pending" ]; then echo "✅ No migrations to apply!"; exit 0; fi
    echo "Migrations to be applied:"; table
    [ "$3" = list ] && exit 0
    echo "? About to apply $(grep -c . "$WR_STATE/pending") migration(s)"
    if read -r answer; then [ "$answer" = y ] || exit 0; fi
    [ "${WR_APPLY:-}" = no ] && exit 0
    if [ "${WR_APPLY:-}" = fail ]; then
      sed -i.bak 1d "$WR_STATE/pending"; echo "X [ERROR] Migration $(head -1 "$WR_STATE/pending") failed" >&2; exit 1
    fi
    : > "$WR_STATE/pending"; echo "applied"
    ;;
  "deploy --dry-run")
    echo "--dry-run: exiting now."
    ;;
  *)
    echo "fake wrangler: unknown command $*" >&2; exit 9
    ;;
esac
